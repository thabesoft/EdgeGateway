<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:avalonia="using:Material.Icons.Avalonia"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:vm="using:ThabeSoft.EdgeGateway.App.ViewModels"
             xmlns:local="using:ThabeSoft.EdgeGateway.App.Features.Topology"
             x:Class="ThabeSoft.EdgeGateway.App.Features.Topology.TopologyView"
             x:DataType="local:TopologyViewModel">

    <suki:GlassCard ClipToBounds="True">
        <suki:SukiSideMenu ItemsSource="{Binding MenuItemsSource}"
                           IsToggleButtonVisible="False"
                           IsSearchEnabled="True"
                           SelectedItem="{Binding SelectedMenu}"
                           UseCustomContent="True">
            <!--菜单-->
            <suki:SukiSideMenu.ItemTemplate>
                <DataTemplate>
                    <suki:SukiSideMenuItem Header="{Binding Header}" ItemsSource="{Binding ChildItemsSource}" Icon="{avalonia:MaterialIconExt Kind=Person}">
                        <suki:SukiSideMenuItem.ItemTemplate>
                            <DataTemplate>
                                <suki:SukiSideMenuItem Header="{Binding Header}"></suki:SukiSideMenuItem>
                            </DataTemplate>
                        </suki:SukiSideMenuItem.ItemTemplate>
                    </suki:SukiSideMenuItem>
                </DataTemplate>
            </suki:SukiSideMenu.ItemTemplate>

            <!--内容页-->
            <suki:SukiSideMenu.Content>
                <Panel>

                    <!--端口页面-->
                    <DockPanel IsVisible="{Binding IsSelecteedPort}">

                        <!--顶部栏-->
                        <DockPanel DockPanel.Dock="Top">

                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">

                                <Button IsVisible="{Binding !SelectedPort.IsOpen}"
                                        Content="打开"
                                        Classes="Information"
                                        Command="{Binding SelectedPort.OpenCommand}" />

                                <Button IsVisible="{Binding SelectedPort.IsOpen}"
                                        Content="关闭"
                                        Command="{Binding SelectedPort.CloseCommand}" />

                                <Separator Height="20" Width="1"></Separator>

                                <Button Content="删除"
                                        Classes="Danger"
                                        Command="{Binding RemoveSelectedPortCommand}" />

                            </StackPanel>

                            <DockPanel>
                                <TextBlock VerticalAlignment="Center" Text="{Binding SelectedPort.ChannelAddress}"></TextBlock>
                            </DockPanel>

                        </DockPanel>

                        <!--内容栏-->
                        <DockPanel>

                            <DataGrid ItemsSource="{Binding SelectedPort.Devices}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserResizeColumns="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="设备 ID" Binding="{Binding Id}" Width="Auto"/>
                                    <DataGridTextColumn Header="协议类型" Binding="{Binding ProtocolType}" Width="Auto"/>

                                    <!--数据点-->
                                    <DataGridTemplateColumn Header="数据点" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <!-- 用一个 Button 伪装成普通的文本，去掉边框和背景 -->
                                                <Button Background="Transparent"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Stretch"
                                                        HorizontalContentAlignment="Center"
                                                        VerticalContentAlignment="Center"
                                                        BorderThickness="0"
                                                        Padding="0"
                                                        Cursor="Hand"
                                                        Content="{Binding}">
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!--操作-->
                                    <DataGridTemplateColumn Header="操作" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="5">
                                                    <Button IsVisible="{Binding !IsEnabled}" Command="{Binding EnableCommand}">启用</Button>
                                                    <Button IsVisible="{Binding IsEnabled}" Command="{Binding DisableCommand}">禁用</Button>
                                                    <Separator Height="20" Width="1"></Separator>
                                                    <Button Command="{Binding $parent[UserControl].DataContext.SelectedPort.RemoveDeviceCommand}"
                                                            CommandParameter="{Binding Id}"
                                                            Content="删除" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>

                            </DataGrid>

                        </DockPanel>

                    </DockPanel>

                    <!--设备页面-->
                    <DockPanel IsVisible="{Binding IsSelectedDevice}">

                        <!--顶部栏-->
                        <DockPanel DockPanel.Dock="Top">

                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">

                                <Button IsVisible="{Binding !SelectedPort.IsOpen}"
                                        Content="启用"
                                        Classes="Information"
                                        Command="{Binding SelectedPort.OpenCommand}" />

                                <Button IsVisible="{Binding SelectedPort.IsOpen}"
                                        Content="禁用"
                                        Command="{Binding SelectedPort.CloseCommand}" />

                                <Separator Height="20" Width="1"></Separator>

                                <Button Content="删除"
                                        Classes="Danger"
                                        Command="{Binding RemoveSelectedPortCommand}" />

                            </StackPanel>

                            <DockPanel>
                                <TextBlock VerticalAlignment="Center" Text="{Binding SelectedPort.ChannelAddress}"></TextBlock>
                            </DockPanel>

                        </DockPanel>

                        <!--内容栏-->
                        <DockPanel>

                            <DataGrid ItemsSource="{Binding SelectedDevice.TagMonitors}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserResizeColumns="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="Auto"/>
                                    <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="Auto"/>
                                    <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="Auto"/>
                                    <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="Auto"/>
                                    <DataGridTextColumn Header="时间" Binding="{Binding UpdateTime}" Width="Auto"/>

                                    <!--操作-->
                                    <DataGridTemplateColumn Header="操作" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                    <Button Command="{Binding $parent[UserControl].DataContext.SelectedPort.RemoveDeviceCommand}"
                                                            CommandParameter="{Binding Name}"
                                                            Content="删除" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>

                            </DataGrid>

                        </DockPanel>

                    </DockPanel>

                </Panel>
            </suki:SukiSideMenu.Content>

        </suki:SukiSideMenu>

    </suki:GlassCard>

</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:avalonia="using:Material.Icons.Avalonia"
             xmlns:controls="using:ThabeSoft.EdgeGateway.App.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:vm="using:ThabeSoft.EdgeGateway.App.ViewModels"
             xmlns:ScottPlot="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
             d:DesignWidth="800"
             xmlns:local="using:ThabeSoft.EdgeGateway.App.Features.Topology"
             x:Class="ThabeSoft.EdgeGateway.App.Features.Topology.TopologyView"
             x:DataType="local:TopologyViewModel">

    <suki:GlassCard ClipToBounds="True" Margin="5" Padding="0">
        <suki:SukiSideMenu ItemsSource="{Binding MenuItemsSource}"
                           Background="Transparent"
                           IsToggleButtonVisible="False"
                           IsSearchEnabled="True"
                           SelectedItem="{Binding SelectedMenu}"
                           UseCustomContent="True">
            <!--菜单-->
            <suki:SukiSideMenu.ItemTemplate>
                <DataTemplate>
                    <suki:SukiSideMenuItem Width="250" Header="{Binding Header}" ItemsSource="{Binding ChildItemsSource}">

                        <suki:SukiSideMenuItem.ItemTemplate>
                            <DataTemplate>
                                <suki:SukiSideMenuItem Header="{Binding Header}"></suki:SukiSideMenuItem>
                            </DataTemplate>
                        </suki:SukiSideMenuItem.ItemTemplate>
                    </suki:SukiSideMenuItem>
                </DataTemplate>
            </suki:SukiSideMenu.ItemTemplate>

            <!--内容页-->
            <suki:SukiSideMenu.Content>
                <Panel Margin="10">

                    <!--端口页面-->
                    <DockPanel IsVisible="{Binding IsSelecteedPort}">

                        <!--顶部栏-->
                        <DockPanel DockPanel.Dock="Top">

                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">

                                <Button IsVisible="{Binding !SelectedPort.IsRunning}"
                                        Content="打开"
                                        Classes="Information"
                                        Command="{Binding SelectedPort.StartCommand}" />

                                <Button IsVisible="{Binding SelectedPort.IsRunning}"
                                        Content="关闭"
                                        Command="{Binding SelectedPort.StopCommand}" />

                                <Separator Height="20" Width="1"></Separator>

                                <Button Content="删除"
                                        Classes="Danger"
                                        Command="{Binding RemoveSelectedPortCommand}" />

                            </StackPanel>

                            <DockPanel>
                                <TextBlock VerticalAlignment="Center" Text="{Binding SelectedPort.Endpoint}"></TextBlock>
                            </DockPanel>

                        </DockPanel>

                        <!--内容栏-->
                        <DockPanel>

                            <DataGrid ItemsSource="{Binding SelectedPort.Devices.Values}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserResizeColumns="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="设备 ID" Binding="{Binding Id}" Width="Auto"/>
                                    <DataGridTextColumn Header="协议类型" Binding="{Binding ProtocolType}" Width="Auto"/>

                                    <!--数据点-->
                                    <DataGridTemplateColumn Header="数据点" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <!-- 用一个 Button 伪装成普通的文本，去掉边框和背景 -->
                                                <Button Background="Transparent"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Stretch"
                                                        HorizontalContentAlignment="Center"
                                                        VerticalContentAlignment="Center"
                                                        BorderThickness="0"
                                                        Padding="0"
                                                        Cursor="Hand"
                                                        Content="{Binding Subscriptions.Count}">
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!--操作-->
                                    <DataGridTemplateColumn Header="操作" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="5">
                                                    <Button IsVisible="{Binding !IsRunning}" Command="{Binding StartCommand}">启用</Button>
                                                    <Button IsVisible="{Binding IsRunning}" Command="{Binding StopCommand}">禁用</Button>
                                                    <Separator Height="20" Width="1"></Separator>
                                                    <Button Command="{Binding $parent[UserControl].DataContext.SelectedPort.RemoveDeviceCommand}"
                                                            CommandParameter="{Binding Id}"
                                                            Content="删除" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>

                            </DataGrid>

                        </DockPanel>

                    </DockPanel>

                    <!--设备页面-->
                    <DockPanel IsVisible="{Binding IsSelectedDevice}">

                        <!--顶部栏-->
                        <DockPanel DockPanel.Dock="Top">

                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">

                                <Button IsVisible="{Binding !SelectedDevice.IsRunning}"
                                        Content="启用"
                                        Classes="Information"
                                        Command="{Binding SelectedDevice.StartCommand}" />

                                <Button IsVisible="{Binding SelectedDevice.IsRunning}"
                                        Content="禁用"
                                        Command="{Binding SelectedDevice.StopCommand}" />

                                <Separator Height="20" Width="1"></Separator>

                                <Button Content="删除"
                                        Classes="Danger"
                                        Command="{Binding RemoveSelectedPortCommand}" />

                            </StackPanel>

                            <DockPanel>
                                <TextBlock VerticalAlignment="Center" Text="{Binding SelectedDevice.Id}"></TextBlock>
                            </DockPanel>

                        </DockPanel>

                        <!--内容栏-->
                        <DockPanel>

                            <DataGrid ItemsSource="{Binding SelectedDevice.Subscriptions.Values}"
                                      AutoGenerateColumns="False"
                                      Padding="10"
                                      IsReadOnly="True"
                                      CanUserResizeColumns="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="100"/>
                                    <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="Auto"/>
                                    <DataGridTextColumn Header="值" Binding="{Binding Latest.Value.Value, StringFormat={}{0:F3}}" Width="Auto"/>
                                    <DataGridTextColumn Header="时间" Binding="{Binding Latest.Value.Timestamp.LocalDateTime, StringFormat={}{0:HH:mm:ss.fff}}" Width="Auto"/>
                                    <DataGridTextColumn Header="质量" Binding="{Binding Latest.Value.Quality}" Width="Auto"/>

                                    <DataGridTemplateColumn Header="图表"  Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <local:SubscriptionChartView DataContext="{Binding}" Height="30" Margin="5 3" />
                                                <!--<controls:SparklineControl Buffer="{Binding Buffer}"
                                                Height="60"
                                                Width="200"
                                                MinHeight="60"
                                                MinWidth="200"
                                                />-->
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>



                                    <!--操作-->
                                    <DataGridTemplateColumn Header="操作" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="5">
                                                    <Button IsVisible="{Binding !IsRunning}" Command="{Binding StartCommand}">启用</Button>
                                                    <Button IsVisible="{Binding IsRunning}" Command="{Binding StopCommand}">禁用</Button>
                                                    <Separator Height="20" Width="1"></Separator>
                                                    <Button Command="{Binding $parent[UserControl].DataContext.SelectedDevice.RemoveSubscriptionCommand}"
                                                            CommandParameter="{Binding Id}"
                                                            Content="删除" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>

                            </DataGrid>

                        </DockPanel>

                    </DockPanel>

                </Panel>
            </suki:SukiSideMenu.Content>

        </suki:SukiSideMenu>

    </suki:GlassCard>

</UserControl>

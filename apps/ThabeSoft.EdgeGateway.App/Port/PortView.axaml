<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:local="using:ThabeSoft.EdgeGateway.App.Port"
             x:Class="ThabeSoft.EdgeGateway.App.Port.PortView"
             x:DataType="local:PortViewModel">
    <DockPanel>

        <!--顶部工具栏-->
        <DockPanel Margin="0 0 0 10"  DockPanel.Dock="Top">

            <Button DockPanel.Dock="Right" Classes="primary" Command="{Binding AddPortCommand}">添加</Button>

            <TextBox MinWidth="250" PlaceholderText="搜索" DockPanel.Dock="Left"></TextBox>
            <Button DockPanel.Dock="Left">筛选</Button>

        </DockPanel>

        <!--端口列表-->
        <DataGrid ItemsSource="{Binding Ports}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserResizeColumns="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="端口 ID" Binding="{Binding Id}" Width="Auto"/>
                <DataGridTextColumn Header="连接类型" Binding="{Binding ConnectionType}" Width="Auto"/>

                <!--设备-->
                <DataGridTemplateColumn Header="设备" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!-- 用一个 Button 伪装成普通的文本，去掉边框和背景 -->
                            <Button Background="Transparent"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    BorderThickness="0"
                                    Padding="0"
                                    Cursor="Hand"
                                    Command="{Binding OpenDeviceCommand}"
                                    Content="{Binding DeviceCount}">
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!--操作-->
                <DataGridTemplateColumn Header="操作" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="5">
                                <Button IsVisible="{Binding !IsOpen}" Command="{Binding OpenCommand}">开启</Button>
                                <Button IsVisible="{Binding IsOpen}" Command="{Binding CloseCommand}">关闭</Button>
                                <Separator Height="20" Width="1"></Separator>
                                <Button Command="{Binding RemoveCommand}">删除</Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>

        </DataGrid>

    </DockPanel>

</UserControl>

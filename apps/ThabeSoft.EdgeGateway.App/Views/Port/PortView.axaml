<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ThabeSoft.EdgeGateway.App.ViewModels"
             d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ThabeSoft.EdgeGateway.App.Views.PortView"
             x:DataType="vm:PortViewModel">

    <Grid ColumnDefinitions="250,Auto,3*">

        <!--导航栏-->
        <ScrollViewer Background="#f0f0f0"  Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">

            <DockPanel>

                <!--功能按钮-->
                <DockPanel DockPanel.Dock="Top">

                    <Button Command="{Binding AddPortCommand}">添加端口</Button>
                    
                </DockPanel>

                <!--导航内容-->
                <TreeView ItemsSource="{Binding Ports}">

                    <TreeView.DataTemplates>

                        <!--标头模板-->
                        <TreeDataTemplate DataType="vm:PortSummaryViewModel" ItemsSource="{Binding Devices}">
                            <StackPanel Height="30" Orientation="Horizontal" Spacing="5" TreeViewItem.IsExpanded="{Binding IsExpanded,Mode=TwoWay }" >

                                <Border VerticalAlignment="Center"
                                        CornerRadius="3"
                                        Background="Green"
                                        Padding="5 2">
                                    <TextBlock VerticalAlignment="Center"
                                               Foreground="White" FontSize="12" FontWeight="Bold" Text="{Binding ChannelAddress.ConnectionType}"/>
                                </Border>

                                <TextBlock Text="{Binding DisplayName}"
                                           VerticalAlignment="Center"
                                           FontWeight="Bold" />

                                <TextBlock Text="{Binding ChannelAddress.Endpoint}"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="Light" />

                            </StackPanel>
                        </TreeDataTemplate>

                        <!--元素模板-->
                        <DataTemplate DataType="vm:DeviceSummaryViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="5">

                                <Border CornerRadius="3" Background="Green" Padding="5 2" VerticalAlignment="Stretch">
                                    <TextBlock VerticalAlignment="Center" TextAlignment="Center" Foreground="White" FontSize="12" FontWeight="Bold" Text="{Binding ProtocolType}"/>
                                </Border>

                                <TextBlock VerticalAlignment="Center" Text="{Binding DisplayName}"/>

                            </StackPanel>
                        </DataTemplate>

                    </TreeView.DataTemplates>

                </TreeView>
            </DockPanel>
        </ScrollViewer>

        <GridSplitter Grid.Column="1"
                      Background="Gray"
                      ResizeDirection="Columns" />

        <ContentControl Grid.Column="2" Content="123"></ContentControl>

    </Grid>

</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="using:EdgeGateway.App.Models"
             xmlns:vm="clr-namespace:EdgeGateway.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="EdgeGateway.App.Views.MainView"
             x:DataType="vm:MainViewModel">
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
        to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Panel>

        <!--内容-->
        <DockPanel>

            <!--菜单-->
            <DockPanel DockPanel.Dock="Left">
                <Border>
                    <ListBox ItemsSource="{Binding Menus}" SelectedItem="{Binding SelectedMenu}" Padding="0,10">

                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="20,12"/>
                                <Setter Property="Foreground" Value="#CCCCCC"/>
                            </Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="#333333"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="#007ACC"/> <!-- VS 经典的蓝色选中 -->
                                <Setter Property="TextElement.Foreground" Value="White"/>
                            </Style>
                        </ListBox.Styles>

                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vm:NavigationMenuItem">
                                <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>
                </Border>
            </DockPanel>

            <!--内容-->
            <ContentControl Content="{Binding SelectedMenu.Target}" Margin="20"></ContentControl>

        </DockPanel>

        <!--弹窗-->
        <Panel IsVisible="{Binding IsShowDialog}">
            <!--遮罩-->
            <Rectangle Fill="Black" Opacity="0.5"></Rectangle>

            <!--弹窗-->
            <Border MinWidth="500"  MinHeight="450"  CornerRadius="8" Background="White" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center"  MaxWidth="800"
                    MaxHeight="600">
                <DockPanel>

                    <!--标题-->
                    <TextBlock DockPanel.Dock="Top" FontWeight="Bold" TextAlignment="Center" Text="{Binding Dialog.Title}" Margin="0 10"></TextBlock>
                    
                    <!--按钮-->
                    <ItemsControl HorizontalAlignment="Center" DockPanel.Dock="Bottom" ItemsSource="{Binding Dialog.Buttons}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="10"></StackPanel>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="m:DialogButton">
                                <Button Padding="5" Content="{Binding Content}" Command="{Binding OnClickCommand}"></Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                    <!--内容-->
                    <ContentControl Content="{Binding Dialog.Content}"></ContentControl>

                </DockPanel>
            </Border>
        </Panel>

    </Panel>

</UserControl>

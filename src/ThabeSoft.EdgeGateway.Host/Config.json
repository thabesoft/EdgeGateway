{
  "Ports": [
    {
      "Descriptor": {
        "Id": "PortId",
        "Transport": {
          "Type": "Ethernet",
          "ProtocolType": "Tcp",
          "Ip": "127.0.0.1",
          "Port": 2333,
          "Retry": {
            "StartInterval": "00:00:03",
            "MaxInterval": "00:00:30",
            "BackoffMultiplier": 1.5
          }
        }
      },
      "Devices": [
        {
          "Descriptor": {
            "Id": "DeviceId",
            "Protocol": {
              "Type": "Modbus",
              "TransportType": "Ethernet",
              "FrameFormat": "Ip"
            },
            "Subscriptions": [
              {
                "Descriptor": {
                  "Id": "SubscriptionId",
                  "Trigger": {
                    "Type": "Interval",
                    "Interval": "00:00:00.100"
                  }
                },
                "Slinks": [
                  {
                    "Type": "Sqlite",
                    "TableName": "HoldingRegisters"
                  },
                  {
                    "Type": "Mqtt",
                    "Topic": "factory/plc1/temperature"
                  }
                ]
              }
            ]
          }
        }
      ]
    },

    {
      "Descriptor": {
        "Id": "SerialPortid",
        "Transport": {
          "Type": "Serial",
          "PortName": "Com3",
          "BaudRate": 9600,
          "DataBits": 8,
          "Parity": "None",
          "StopBits": "One",
          "Retry": {
            "StartInterval": "00:00:03",
            "MaxInterval": "00:00:30",
            "BackoffMultiplier": 1.5
          }
        }
      }
    }
  ]
}